# Monad Testnet
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Passkey relying party (must match the production domain; passkeys are bound to it)
NEXT_PUBLIC_RP_ID=rewapp-app.vercel.app

# Contract addresses (filled after deploy)
NEXT_PUBLIC_USDR_ADDRESS=0x6e68D7b4Ea589F43B8DAbD36b2f4933fE4FA1d4a
NEXT_PUBLIC_REWAPP_PAY_ADDRESS=0x099DD721e4916e37b51E713FA72f7285101B2551

# Server-only
RELAYER_PRIVATE_KEY=
# Local PostgreSQL from compose.yaml (development-only credentials).
# In Vercel, replace both URLs with the corresponding Neon/Postgres connections.
DATABASE_URL=postgresql://rewapp:rewapp_local@127.0.0.1:5434/rewapp?schema=public
DATABASE_URL_UNPOOLED=postgresql://rewapp:rewapp_local@127.0.0.1:5434/rewapp?schema=public
