generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ChargeStatus {
  PENDING
  PAID
  EXPIRED
  PROCESSING
  SPLIT
}

enum RewardAudience {
  CUSTOMER
  COMMERCE
}

model Merchant {
  id       String   @id @default(cuid())
  name     String
  logoUrl  String?
  category String
  country  String
  currency String
  address  String   @unique
  charges  Charge[]
  rewards PlatformReward[]
}

model Charge {
  id            String       @id @default(cuid())
  merchant      Merchant     @relation(fields: [merchantId], references: [id])
  merchantId    String
  localAmount   Decimal      @db.Decimal(18, 2)
  localCurrency String
  // USDr base units (6 decimals).
  usdAmount     BigInt
  status        ChargeStatus @default(PENDING)
  txHash        String?
  payer         String?
  createdAt     DateTime     @default(now())
  expiresAt     DateTime
  expectedPayer String?
  parentId      String?
  parent        Charge? @relation("SplitCharges", fields: [parentId], references: [id])
  parts         Charge[] @relation("SplitCharges")
  splitOwner    String?
  groupId       String?

  @@index([merchantId, createdAt])
}

model Profile {
  address  String  @id
  alias    String?
  country  String?
  currency String  @default("USD")
}

/// Only fictional fixture IDs. Not a vault for payment credentials.
model SavedDemoCard {
  id             String   @id @default(cuid())
  accountAddress String
  demoId         String
  createdAt      DateTime @default(now())

  @@unique([accountAddress, demoId])
}

model FxRate {
  currency  String   @id
  // Units of this currency per 1 USD.
  usdRate   Decimal  @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt
}

model BackupVault {
  credentialId   String   @id
  accountAddress String
  vault          Json
  createdAt      DateTime @default(now())

  @@index([accountAddress])
}

model PlatformReward {
  id          Int            @id
  audience    RewardAudience
  title       String
  description String
  imageUrl    String?
  pointsCost  Int
  active      Boolean        @default(true)
  merchantId  String?
  merchant    Merchant? @relation(fields: [merchantId], references: [id])
  redemptions Redemption[]
}

/// Simulated top-ups minted by the relayer; also the source for rate limits.
model Onramp {
  id          String   @id @default(cuid())
  address     String
  ip          String
  localAmount Decimal  @db.Decimal(18, 2)
  currency    String
  usdAmount   BigInt
  txHash      String?
  createdAt   DateTime @default(now())

  @@index([address, createdAt])
  @@index([ip, createdAt])
}

model Contact {
  id String @id @default(cuid())
  owner String
  address String
  label String
  @@unique([owner, address])
}

model SocialGroup {
  id String @id @default(cuid())
  owner String
  name String
  kind String
  members Json
}

model ApiAuthorization {
  id String @id
  account String
  createdAt DateTime @default(now())
}

model WorkspaceSession {
  tokenHash String @id
  account String
  expiresAt DateTime
}

model Redemption {
  id String @id @default(cuid())
  account String
  nonce String
  rewardId Int
  reward PlatformReward @relation(fields: [rewardId], references: [id])
  title String
  pointsCost Int
  merchantId String?
  status String @default("PROCESSING")
  txHash String? @unique
  pickupCode String @unique
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@unique([account, nonce])
  @@index([account, createdAt])
}
